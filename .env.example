# IsaiahAIhub Environment Configuration

# Optional: GitHub Personal Access Token (classic or fine-grained with public repo read access)
# Without this, GitHub API allows 60 unauthenticated requests/hour per IP.
# With GITHUB_TOKEN set, the rate limit increases to 5,000 requests/hour.
# This variable is strictly server-side and never exposed to the browser.
GITHUB_TOKEN=""

# Server port (defaults to 3000 if omitted)
PORT=3000
